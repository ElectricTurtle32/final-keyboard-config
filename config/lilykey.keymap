#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -------------------------------------------------------------------------
            // | ESC  |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | TAB  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |  \   |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  | ENT  |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | SHFT |
            // | CTRL | ALT | GUI | SPC | SPC | LWR |   | RSE | SPC | LFT | DWN | UP  | RGT  |

            bindings = <
&kp ESC   &kp N1   &kp N2   &kp N3   &kp N4   &kp N5       &kp N6   &kp N7   &kp N8   &kp N9   &kp N0   &kp BSPC
&kp TAB   &kp Q    &kp W    &kp E    &kp R    &kp T        &kp Y    &kp U    &kp I    &kp O    &kp P    &kp BSLH
&kp LCTRL &kp A    &kp S    &kp D    &kp F    &kp G        &kp H    &kp J    &kp K    &kp L    &kp SEMI &kp RET
&kp LSHFT &kp Z    &kp X    &kp C    &kp V    &kp B        &kp N    &kp M    &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
&kp LCTRL &kp LALT &kp LGUI &kp SPACE &mo 1   &mo 1        &mo 2    &kp SPACE &kp LEFT &kp DOWN &kp UP   &kp RIGHT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------
            // | TILD |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | DEL  |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |  ;   |
            // |      |     |     | LPAR | RPAR |     |   |  -  |  =  |  [  |  ]  |  `  |      |
            // |      |     |     |     |     |     |   |     |     |     |     |     |      |
            // |      |     |     |     |     |     |   |     |     |     |     |     |      |

            bindings = <
&kp TILDE  &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT     &kp CARET &kp AMPS  &kp STAR &kp LPAR &kp RPAR &kp BSPC
&kp DEL    &kp N1   &kp N2   &kp N3   &kp N4   &kp N5        &kp N6    &kp N7    &kp N8   &kp N9   &kp N0   &kp SEMI
&trans     &trans   &trans   &kp LPAR &kp RPAR &trans        &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp GRAVE &trans
&trans     &trans   &trans   &trans   &trans   &trans        &trans    &trans    &trans   &trans   &trans   &trans
&trans     &trans   &trans   &trans   &trans   &trans        &trans    &trans    &trans   &trans   &trans   &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------
            // | F1  | F2  | F3  | F4  | F5  | F6  |   | F7  | F8  | F9  | F10 | F11 | F12 |
            // |     |     |     |     |     |     |   |     |     |     |     |     |     |
            // |     |     |     |     |     |     |   |     |     |     |     |     |     |
            // |     |     |     |     |     |     |   |     |     |     |     |     |     |
            // |     |     |     |     |     |     |   |     |     |     |     |     |     |

            bindings = <
&kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6        &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&trans    &trans    &trans    &trans    &trans    &trans        &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans        &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans        &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans        &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };
    };
};
