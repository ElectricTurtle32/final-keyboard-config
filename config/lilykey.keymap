#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        display-name = "LilyKey";

        default_layer {
            display-name = "Default";
            // All keys output 'q' for testing
            
            bindings = <
&kp Q &kp Q &kp Q &kp Q &kp Q &kp Q       &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q
&kp Q &kp Q &kp Q &kp Q &kp Q &kp Q       &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q
&kp Q &kp Q &kp Q &kp Q &kp Q &kp Q       &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q
&kp Q &kp Q &kp Q &kp Q &kp Q &kp Q       &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q
&kp Q &kp Q &kp Q &kp Q &kp Q &kp Q       &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp Q &kp Q &kp Q &kp Q &kp Q &kp Q       &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q
&kp Q &kp Q &kp Q &kp Q &kp Q &kp Q       &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q
&kp Q &kp Q &kp Q &kp Q &kp Q &kp Q       &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q
&kp Q &kp Q &kp Q &kp Q &kp Q &kp Q       &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q
&kp Q &kp Q &kp Q &kp Q &kp Q &kp Q       &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp Q &kp Q &kp Q &kp Q &kp Q &kp Q       &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q
&kp Q &kp Q &kp Q &kp Q &kp Q &kp Q       &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q
&kp Q &kp Q &kp Q &kp Q &kp Q &kp Q       &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q
&kp Q &kp Q &kp Q &kp Q &kp Q &kp Q       &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q
&kp Q &kp Q &kp Q &kp Q &kp Q &kp Q       &kp Q &kp Q &kp Q &kp Q &kp Q &kp Q
            >;
        };
    };
};